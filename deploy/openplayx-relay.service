# Reference copy of the unit written by `openplayx-relay install` (default paths).
[Unit]
Description=OpenPlayX relay (manager + embedded sing-box + frps)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openplayx-relay
Group=openplayx-relay
ExecStart=/opt/openplayx-relay/current/openplayx-relay serve --config-dir /var/lib/openplayx-relay
Restart=on-failure
RestartSec=5
UMask=0077
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/openplayx-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
