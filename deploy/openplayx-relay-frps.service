[Unit]
Description=OpenPlayX relay frps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/openplayx-relay/current/bin/frps -c /opt/openplayx-relay/current/config/frps.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/openplayx-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Config directories must be readable by the service via a dedicated group.
SupplementaryGroups=openplayx-relay
UMask=0077

[Install]
WantedBy=multi-user.target
