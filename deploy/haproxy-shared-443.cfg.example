# Replace PUBLIC_IP and PROXY_SERVER_NAME before installing in
# /etc/haproxy/haproxy.cfg. Bind the real public interface, not 0.0.0.0:
# sing-box and the manager use separate loopback addresses on the same port.
global
    user haproxy
    group haproxy
    daemon
    maxconn 2048

defaults
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend shared_tls
    bind PUBLIC_IP:443
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    use_backend vless if { req.ssl_sni -i PROXY_SERVER_NAME }
    default_backend management

backend vless
    server proxy 127.0.0.1:443 check

backend management
    server manager 127.0.0.2:443 check
